generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  username  String    @unique
  email     String    @unique
  password  String
  hubs      Hub[]
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  refreshToken String   @unique
  isRevoked    Boolean  @default(false)
  userAgent    String
  ipAddress    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Hub {
  id        String       @id @default(uuid()) @db.Uuid
  hubName   String
  layout    Json?
  userId    String?      @db.Uuid
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  imgs      HubImage[]
  features  HubFeature[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@map("hubs")
}

model HubImage {
  id        String   @id @default(uuid()) @db.Uuid
  imgUrl    String
  htmlId    String
  position  Json
  hubId     String   @db.Uuid
  hub       Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hubId])
  @@map("hub_images")
}

model HubFeature {
  id        String   @id @default(uuid()) @db.Uuid
  feature   String
  htmlId    String
  position  Json
  hubId     String   @db.Uuid
  hub       Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hubId])
  @@map("hub_features")
}

model GameDataBinding {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  group     String
  format    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("game_data_bindings")
}

model GameDataState {
  id        String   @id @default(uuid()) @db.Uuid
  source    String
  connected Boolean  @default(false)
  game      Json
  team      Json
  player    Json
  events    Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("game_data_states")
}
